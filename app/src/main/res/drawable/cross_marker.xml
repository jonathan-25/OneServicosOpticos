<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Anel externo (com borda mais fina) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent"/> <!-- Centro transparente -->
            <size android:width="50dp" android:height="50dp"/> <!-- Tamanho do anel -->
            <stroke android:width="1.2dp" android:color="#FF0000"/> <!-- Borda 60% mais fina -->
        </shape>
    </item>

    <!-- Ponto central menor -->
    <item android:width="1dp" android:height="1dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#FF0000"/> <!-- Vermelho sólido -->
        </shape>
    </item>

</layer-list>
