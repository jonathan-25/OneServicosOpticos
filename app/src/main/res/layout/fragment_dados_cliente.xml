<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"> <!-- Fundo branco -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cadastro de Clientes"
            android:textSize="24sp"
            android:textColor="#000000"
            android:gravity="center"
            android:padding="8dp"/>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/baseline_person_24"
            android:contentDescription="Ícone Nome"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/label_nome"
            android:text="Nome"
            android:textColor="#000000"
            android:layout_gravity="center_vertical"
            android:paddingStart="8dp"/>
    </LinearLayout>


        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/editnome"
            android:hint="nome"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:background="@drawable/edit_text_background"
            android:padding="12dp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/label_sobrenome"
            android:text="Sobrenome"
            android:textColor="#000000"
            android:paddingBottom="4dp"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/editSobrenome"
            android:hint="Sobrenome"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:background="@drawable/edit_text_background"
            android:padding="12dp"
            android:layout_marginTop="8dp"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/label_Cpf"
            android:text="CPF"
            android:textColor="#000000"
            android:paddingBottom="4dp"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/editCpf"
            android:hint="CPF"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:background="@drawable/edit_text_background"
            android:padding="12dp"
            android:layout_marginTop="8dp"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/label_email"
            android:text="Email"
            android:textColor="#000000"
            android:paddingBottom="4dp"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/editEmail"
            android:hint="Email"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:background="@drawable/edit_text_background"
            android:padding="12dp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/label_endereco"
            android:text="Endereço"
            android:textColor="#000000"
            android:paddingTop="12dp"
            android:paddingBottom="1dp"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/endereco"
            android:hint="Endereço"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:background="@drawable/edit_text_background"
            android:padding="12dp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/label_telefone"
            android:text="Telefone"
            android:textColor="#000000"
            android:paddingTop="12dp"
            android:paddingBottom="1dp"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/telefone"
            android:hint="Telefone"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:background="@drawable/edit_text_background"
            android:padding="12dp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/label_celular"
            android:text="Celular"
            android:textColor="#000000"
            android:paddingTop="12dp"
            android:paddingBottom="1dp"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/celular"
            android:hint="Celular"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:background="@drawable/edit_text_background"
            android:padding="12dp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/label_instagram"
            android:text="Instagram"
            android:textColor="#000000"
            android:paddingTop="12dp"
            android:paddingBottom="1dp"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/instagram"
            android:hint="Instagram"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:background="@drawable/edit_text_background"
            android:padding="12dp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/label_facebook"
            android:text="Facebook"
            android:textColor="#000000"
            android:paddingTop="12dp"
            android:paddingBottom="1dp"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/facebook"
            android:hint="Facebook"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:background="@drawable/edit_text_background"
            android:padding="12dp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/label_nome_medico"
            android:text="Nome do Médico"
            android:textColor="#000000"
            android:paddingTop="12dp"
            android:paddingBottom="1dp"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/nome_medico"
            android:hint="Nome do Médico"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:background="@drawable/edit_text_background"
            android:padding="12dp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/label_crm_medico"
            android:text="CRM do Médico"
            android:textColor="#000000"
            android:paddingTop="12dp"
            android:paddingBottom="1dp"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/crm_medico"
            android:hint="CRM do Médico"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:background="@drawable/edit_text_background"
            android:padding="12dp"
            android:layout_marginTop="8dp"/>





        <!-- Campos menores em 3 linhas e 3 colunas -->
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*"
            android:layout_marginTop="16dp">

            <TableRow>
                <TextView
                    android:id="@+id/labelDnpD"
                    android:layout_weight="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:text="DNP D"
                    android:textColor="#000000"
                    android:padding="4dp"/>



                <TextView
                    android:id="@+id/labelAlturaD"
                    android:layout_weight="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:text="Altura D"
                    android:textColor="#000000"
                    android:padding="4dp"/>



                <TextView
                    android:id="@+id/labelPrismaD"
                    android:layout_weight="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:text="Prisma D"
                    android:textColor="#000000"
                    android:padding="4dp"/>

                <TextView
                    android:id="@+id/labelEixoPrismaD"
                    android:layout_weight="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:text="Prisma D"
                    android:textColor="#000000"
                    android:padding="4dp"/>


            </TableRow>


            <TableRow>

                <EditText
                    android:id="@+id/editDnpD"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_background"
                    android:hint="DNP D"
                    android:padding="14dp"
                    android:textColor="#000000"
                    android:textColorHint="#888888"
                    android:textSize="16sp" />


                <EditText
                    android:id="@+id/editAlturD"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_background"
                    android:hint="DNP D"
                    android:padding="14dp"
                    android:textColor="#000000"
                    android:textColorHint="#888888"
                    android:textSize="16sp" />


                <EditText
                    android:id="@+id/editPrismaD"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_background"
                    android:hint="DNP D"
                    android:padding="14dp"
                    android:textColor="#000000"
                    android:textColorHint="#888888"
                    android:textSize="16sp" />


                <EditText
                    android:id="@+id/editEixoPrismaD"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_background"
                    android:hint="Prism D"
                    android:padding="14dp"
                    android:textColor="#000000"
                    android:textColorHint="#888888"
                    android:textSize="16sp" />


            </TableRow>




            <TableRow>
                <TextView
                    android:id="@+id/labelDnpE"
                    android:layout_weight="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:text="DNP E"
                    android:textColor="#000000"
                    android:padding="4dp"/>



                <TextView
                    android:id="@+id/labelAlturaE"
                    android:layout_weight="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:text="Altura E"
                    android:textColor="#000000"
                    android:padding="4dp"/>



                <TextView
                    android:id="@+id/labelPrismaE"
                    android:layout_weight="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:text="Prisma E"
                    android:textColor="#000000"
                    android:padding="4dp"/>

                <TextView
                    android:id="@+id/labelEixoPrismaE"
                    android:layout_weight="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:text="Prisma E"
                    android:textColor="#000000"
                    android:padding="4dp"/>


            </TableRow>


            <TableRow>

                <EditText
                    android:id="@+id/editDnpE"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_background"
                    android:hint="DNP E"
                    android:padding="14dp"
                    android:textColor="#000000"
                    android:textColorHint="#888888"
                    android:textSize="16sp" />


                <EditText
                    android:id="@+id/editAlturE"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_background"
                    android:hint="DNP E"
                    android:padding="14dp"
                    android:textColor="#000000"
                    android:textColorHint="#888888"
                    android:textSize="16sp" />


                <EditText
                    android:id="@+id/editPrismaE"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_background"
                    android:hint="DNP E"
                    android:padding="14dp"
                    android:textColor="#000000"
                    android:textColorHint="#888888"
                    android:textSize="16sp" />


                <EditText
                    android:id="@+id/editEixoPrismaE"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_background"
                    android:hint="Prism E"
                    android:padding="14dp"
                    android:textColor="#000000"
                    android:textColorHint="#888888"
                    android:textSize="16sp" />


            </TableRow>

        </TableLayout>
    </LinearLayout>
</ScrollView>